# SafeLens Backend API Environment Variables

# The port Express listens on (Render automatically supplies PORT=10000)
PORT=4000

# Base Sepolia Testnet RPC (Public endpoint, no API key needed)
RPC_URL=https://sepolia.base.org

# Deployed SafeLensRegistry contract address on Base Sepolia
CONTRACT_ADDRESS=0xb0E56de2C6aD146F9b6c8c86084046EC1200859c

# Backend service wallet private key that signs registerReport() gasless on-chain anchoring transactions.
# (Leave blank or add your funded Base Sepolia wallet private key)
PRIVATE_KEY=

# Comma-separated list of allowed frontend origins for CORS.
# Leave empty to allow all incoming origins (useful during initial staging).
CLIENT_ORIGIN=https://safelens.vercel.app,http://localhost:5173

# Google AI Studio API Key & Gemma 4 Configuration
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMMA_MODEL=gemma-4-31b-it

# Neon Serverless Postgres Database Connection String (from neon.tech console)
DATABASE_URL=postgresql://neondb_owner:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
